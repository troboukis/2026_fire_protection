{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run metadata:check && tsc -b && vite build",
    "build:pages": "npm run metadata:check && tsc -b && vite build --base=/fire_protection/",
    "sync:west-attica-fire": "node ../scripts/sync_west_attica_fire_dist.mjs",
    "sync:cities": "cp -f ../data/geo/greek_cities.json ./public/greek_cities.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "metadata:generate": "node ../scripts/generate_page_metadata.mjs",
    "metadata:check": "node ../scripts/generate_page_metadata.mjs --check"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.107.0",
    "@vercel/analytics": "^2.0.1",
    "d3": "^7.9.0",
    "i18next": "^26.7.2",
    "maplibre-gl": "^5.24.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.1.13",
    "react-router-dom": "^7.18.5",
    "vanilla-cookieconsent": "^3.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/d3": "^7.4.3",
    "@types/node": "^22.19.19",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-test-renderer": "^18.3.2",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "react-test-renderer": "^18.3.1",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^6.4.6",
    "vitest": "^4.1.12"
  }
}
